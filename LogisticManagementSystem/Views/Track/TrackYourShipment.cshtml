
@model LogisticManagementSystem.Models.TrackModel


<!DOCTYPE html>

<html>
<head>
    <style>

        .row {
            margin-top: 30px;
        }

        #login-div {
            left: 15%;
            top: 20%;
            border: 3px solid #ccc;
            padding: 30px 30px;
            border-radius: 20px 20px 20px 20px;
            opacity: 0.80;
            margin-top: 0px;
            margin-bottom: 10px;
        }

        /*body
        {
            background:url("Script/4Nqctev.jpg");
        }*/
        /*div {
            background:repeat-y;
            background-color: ActiveBorder;
            opacity: 0.75;
        }*/

        table {
            border-collapse: collapse;
        }

        td {
            padding: 25px;
        }

        .field-validation-error {
            color: red;
        }
    </style>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#submit").click(function () {
                debugger;
                var count = 0;
                if ($("#CustomberName").val() == "") {
                    $("#CustomberName").val('');
                    $("#CustomberName").css({ "border-color": "red" });
                    $("#CustomberName").attr("placeholder", "please enter Your Name ");
                    count++;
                }
                if ($("#CompanyName").val() == "") {
                    $("#CompanyName").val('');
                    $("#CompanyName").css({ "border-color": "red" });
                    $("#CompanyName").attr("placeholder", "please enter Company Name ");
                    count++;
                }
                var shipmentid = $("#ShipmentId").val();
                var exp = /^[0-9]{1,}$/;
                if (!shipmentid.match(exp) || shipmentid == "") {
                    $("#ShipmentId").val('')
                    $("#ShipmentId").css({ "border-color": "red" });
                    $("#ShipmentId").attr("placeholder", "please enter ShipmentId");
                    count++;
                }
              
                if (count == 0) {
                    return true;
                }
                else {
                    return false;
                }


            });
            $("#CustomberName").keypress(function () {
                $("#CustomberName").css({ "border-color": "skyblue" });
            });
            $("#CompanyName").keypress(function () {
                $("#CompanyName").css({ "border-color": "skyblue" });
            });
            $("#ShipmentId").keypress(function () {
                $("#ShipmentId").css({ "border-color": "skyblue" });
            });
        });

    </script>
</head>
<body>
    <h2 style="color:orange;color:greenyellow;margin-top:60px;text-align:center">HELLO!Welcome in Track Shipment Page</h2>
    <div class="row">

        <div class="col-lg-3"></div>
        <div class="col-lg-6">

            <div id="login-div" style="background-color:bisque;border:6px solid ;">

                @using (Html.BeginForm("TrackYourShipment", "Track", FormMethod.Post))
                {

                <table>
                    <tr>
                        <td class="form-control-label" style="text-align:right;/*color:aliceblue*/font-size:larger;font-weight:bold">
                            @Html.LabelFor(model => model.CustomberName)
                        </td>
                        <td>@Html.TextBoxFor(model => model.CustomberName, new { @class = "form-control input-lg", placeholder = "Enter Your Name" }) </td>
                    </tr>

                    <tr>
                        <td class="form-control-label" style="text-align:right;font-size:large;font-weight:bold">
                            @Html.LabelFor(model => model.CompanyName)
                        </td>

                        <td>@Html.TextBoxFor(model => model.CompanyName, new { @class = "form-control input-lg", placeholder = "Enter Company Name" }) </td>

                    </tr>

                    <tr>
                        <td class="form-control-label" style="text-align:right;font-size:large;font-weight:bold">
                            @Html.LabelFor(model => model.ShipmentId)
                        </td>


                        <td>@Html.TextBoxFor(model => model.ShipmentId, new { @class = "form-control input-lg", placeholder = "Enter ShipmentId" }) </td>

                    </tr>

                    <tr>
                        <td></td>
                        <td>
                            <input type="submit" class="btn btn-success" name="name" value="Track your location" id="submit" />

                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td><label id="lbl_AuthError" class="field-validation-error">@Html.DisplayFor(model => model.Message)</label></td>
                    </tr>

                </table>

                }
            </div>
        </div>


        @* <script src="~/Script/jquery-3.3.1.min.js"></script>
        <script src="~/Bootstrap/js/bootstrap.min.js"></script>
        <link href="~/Bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <script src="~/Script/jquery.validate.js"></script>
        <script src="~/Script/jquery.validate.unobtrusive.js"></script>
        <link href="~/Script/MyCss.css" rel="stylesheet" /> *@

     


    </div>
</body>
</html>

