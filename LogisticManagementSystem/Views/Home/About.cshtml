@model LogisticManagementSystem.Models.EnquiryModel
@{
    ViewBag.Title = "ABOUTUS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<title>ABOUTUS</title>
<style>
    fieldset.scheduler-border {
        border: solid 4px #DDD !important;
        padding: 0 10px 10px 10px;
        border-bottom: none;
    }
    legend.scheduler-border {
        width: auto !important;
        border: groove;
        font-size: 30px;
        color: aqua
    }
</style>
<body>
    <div class="container">
        <h2 style="color:orange;margin-top:50px">
            ONESPOT SOlUTION LOGISTIC
        </h2>
        <div id="myCarousel" class="carousel slide" data-ride="carousel">
            <!-- Indicators -->
            <ol class="carousel-indicators">
                <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                <li data-target="#myCarousel" data-slide-to="1"></li>
                <li data-target="#myCarousel" data-slide-to="2"></li>
                <li data-target="#myCarousel" data-slide-to="3"></li>
                <li data-target="#myCarousel" data-slide-to="4"></li>
            </ol>

            <!-- Wrapper for slides -->
            <div class="carousel-inner">
                <div class="item active">
                    <img src="~/Image/LogiticwareHouse.jpg" alt="LogisticStore" style="width:100%;height:500px" />
                    

                </div>

                <div class="item">

                    
                    <img src="~/Image/Blog-Heading-1.jpg" alt="Blog" style="width:100%;height:500px" />

                </div>

                <div class="item">
                    <img src="~/Image/LogisticMechanismImage.jpg" alt="Logistic_Mechanism" style="width:100%;height:500px" />

                   
                </div>
                <div class="item">
                    <img src="~/Image/Transport_Road_Vehicle.jpg" alt="Vechile on Road " style="width:100%;height:500px" />
                    
                </div>
                <div class="item">
                    <img src="~/Image/Truck.jpg"alt="Truck_Image" style="width:100%;height:500px" />
                   

                </div>
            </div>

            <!-- Left and right controls -->
            <a class="left carousel-control" href="#myCarousel" data-slide="prev">
                <span class="glyphicon glyphicon-chevron-left"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="right carousel-control" href="#myCarousel" data-slide="next">
                <span class="glyphicon glyphicon-chevron-right"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>
    </div>

</body>
<div class="row">
    <div class="col-lg-1 col-md-1 col-sm-0 col-xs-0"></div>
    <div class="col-lg-10 col-md-10 col-sm-0-col-xs-0" style="margin-top:30px;margin-bottom:30px">
        <fieldset class="scheduler-border">
            <legend class="scheduler-border">ABOUTUS</legend>

            <h4 style="background-image: url('../../pictures/pexels-photo-132197.jpeg');color:black">


                We provide a one-stop solution for all of your shipping and transportation needs.
                ONESPOT SULUTION LOGISTIC Transport was founded by Rohit kumar, a thirty-year trucking industry veteran, to provide people with a friendly, simple, and streamlined approach to taking care of all your shipping needs. We offer a full suite of transportation and logistics services throughout India.

                The combined experience of the ONESPOT SULUTION LOGISTIC management team, along with our open and honest approach to communication and customer relations, has shaped ONESPOT SULUTION LOGISTIC into who we are today.

                Focused on Integrity, Efficiency, and Teamwork
                Integrity, efficiency, and teamwork are at the heart of what we do, and you’ll find that attitude in our office staff, our mechanics, our drivers, and our customers. We believe that every individual and every client is unique; we create programs and solutions that take your specific needs and create flexible, customized shipping solutions.

                At ONESPOT SULUTION LOGISTIC we’re driven to deliver your freight safely and on time. We pride ourselves on service first and at ONESPOT SULUTION LOGISTIC, that means being people-oriented. When you call our office we connect you to our staff—not a phone recording—so you get fast, friendly, and efficient service every time.

                ONESPOT SULUTION LOGISTIC is committed to treating all members of our industry – drivers, in particular – with the recognition and respect they deserve.

                What Sets us Apart from Other Trucking Companies?

                Our dedicated team of skilled logistics and trucking professionals
                Our commitment to safety and certifications
                Our top-notch facilities and equipment
                Our logistics and fleet management technology
                Our drive to change and improve the trucking industry
                Interested in working with the ONESPOT SULUTION LOGISTIC team? Contact us today.
            </h4>
        </fieldset>
    </div>
</div>
@Html.Partial("_EnquiryPage", Model)


