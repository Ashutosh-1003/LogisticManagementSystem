@model List<LogisticManagementSystem.Models.ShipmentModel>
<head>

    <style>
        .row {
            margin-top: 300px;
        }
    </style>
</head>
<h1 style="margin-top:80px;margin-left:350px;color:greenyellow;margin-right:300px">WELCOME IN ADMIN HOME PAGE</h1>

<body>
    @using (Html.BeginForm())
    {


        <div class="container" style="margin-top:70PX">


            <table class="table table-responsive">
                <thead>
                    <tr style="background-color:antiquewhite;color:darkseagreen">
                        <th>ShipmentId</th>
                        <th>CompanyName</th>
                        <th>ContactPersonName</th>
                        <th>CompanyState</th>
                        <th>Companycity</th>
                        <th>ContactNumber</th>
                        <th>CompanyType</th>
                        <th>Pickupdate</th>
                    </tr>
                </thead>
                @foreach (var v in Model)
                {
                    <tbody>

                        <tr>
                            <td>@Html.ActionLink(Convert.ToString(v.ShipmentId), "GetIddetails", v)</td>
                            <td>@v.CompanyName</td>
                            <td>@v.ContactPersonName</td>
                            <td>@v.CompanyState</td>
                            <td>@v.CompanyCity</td>
                            <td>@v.ContactNumber</td>
                            <td>@v.CompanyType</td>
                            <td>@v.PickUpDate</td>
                        </tr>

                    </tbody>
                }
            </table>

        </div>

    }


</body>
<li>@Html.ActionLink("Logout", "Logout", "Login", null, new { @class = "btn btn-success my-2 my-sm-0" })</li>