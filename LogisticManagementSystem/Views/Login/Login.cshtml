


@model LogisticManagementSystem.Models.LoginModel


<!DOCTYPE html>

<html>
<head>
    <style>
        
            .row
                {
                margin-top:60px;
                }

        #login-div {
             
            left: 15%;
            top: 20%;
            border: 1px solid #ccc;
            padding: 40px 40px;
            border-radius: 20px 20px 20px 20px;
            opacity: 0.75;
            margin-top:0px;
            margin-bottom:30px;
            
        }

        /*body
        {
            background:url("Script/4Nqctev.jpg");
        }*/
        /*div {
            background:repeat-y;
            background-color: ActiveBorder;
            opacity: 0.75;
        }*/

        table {
            border-collapse: collapse;
        }

        td {
            padding: 10px;
        }

        .field-validation-error {
            color: red;
        }
    </style>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#submit").click(function () {
                debugger;
                var count = 0;
                if ($("#UserEmail").val() == "") {
                    $("#UserEmail").val('');
                    $("#UserEmail").css({ "border-color": "red" });
                    $("#UserEmail").attr("placeholder", "please enter usermail ");
                    count++;
                }
                if ($("#Password").val() == "") {
                    $("#Password").val('');
                    $("#Password").css({ "border-color": "red" });
                    $("#Password").attr("placeholder", "please enter password ");
                    count++;
                }
                if (count == 0) {
                    return true;
                }
                else {
                    return false;
                }


            });
        });
       
    </script>
</head>
<body>
   <h2 style="color:greenyellow;margin-top:60px;text-align:center">HELLO!WELCOME IN EMPLOYEE LOGIN PAGE</h2>
   <div class="row">

        <div class="col-lg-4"></div>
        <div class="col-lg-4">
      
            <div id="login-div" style="background-color:lavender;border:2px solid gray;">

                @using (Html.BeginForm("Login", "Login", FormMethod.Post))
                {

                    <table>
                        <tr>
                            <td class="form-control-label" style="text-align:right;/*color:aliceblue*/font-size:larger;font-weight:bold">
                                @Html.LabelFor(model => model.UserName)
                            </td>
                            <td>@Html.TextBoxFor(model => model.UserEmail, new { @class = "form-control" }) </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>@Html.ValidationMessageFor(model => model.UserEmail)</td>
                        </tr>
                        <tr>
                            <td class="form-control-label" style="text-align:right;font-size:large;font-weight:bold">
                                @Html.LabelFor(model => model.Password)
                            </td>
                            <td>
                                @Html.PasswordFor(model => model.Password, new { @class = "form-control" })
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                @Html.ValidationMessageFor(model => model.Password)
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td><label id="lbl_AuthError" class="field-validation-error">@Html.DisplayFor(model => model.LoginErrorMessage)</label></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <input type="submit" class="btn btn-success" name="name" value="Login" id="submit" />
                                <input type="button" class="btn btn-danger" id="resetbtn" name="name" value="Reset" />
                            </td>
                        </tr>

                    </table>

                }
            </div>
      </div> 


       @* <script src="~/Script/jquery-3.3.1.min.js"></script>
            <script src="~/Bootstrap/js/bootstrap.min.js"></script>
            <link href="~/Bootstrap/css/bootstrap.min.css" rel="stylesheet" />
            <script src="~/Script/jquery.validate.js"></script>
            <script src="~/Script/jquery.validate.unobtrusive.js"></script>
            <link href="~/Script/MyCss.css" rel="stylesheet" /> *@

        <script type="text/javascript">
        $(function () {
            $('#resetbtn').click(function () {
                $('#UserEmail').val('');
                $('#Password').val('');
                $('#lbl_AuthError').text('');
                $('#Email-error').text('');
                $('#Password-error').text('');
            });
        })

        </script>

    </div> 
</body>
</html>

