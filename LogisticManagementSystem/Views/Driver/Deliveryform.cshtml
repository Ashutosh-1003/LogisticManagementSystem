@model LogisticManagementSystem.Models.ShipmentModel
    @{
        ViewBag.Title = "Deliveryform";
    }
<head>
    <script type="text/javascript">
            $(function () {
                $('#datetimepicker3').datetimepicker({
                    format: 'LT'
                });
            });
    </script>
</head>
  @using (Html.BeginForm())
  {
      <div class="row">
    <div class="col-lg-1 col-md-1 col-sm-0 col-xs-0">
    </div>
    <div class="col-lg-10">
        <div class="panel panel-info" style="margin-top:80px;background-color:burlywood">
            <div class="panel-heading" style="height:70px;background-color:greenyellow"><h2>Delivery page</h2></div>
            <div class="panel-body">

                <div class="col-lg-6 col-md-6 col-sm-0 col-xs-0">
                    <div class="form-group">
                        <h4>Shipmentid</h4>
                        @Html.TextBoxFor(shipmentid => shipmentid.ShipmentId, new { @readonly = "readonly", @class = "form-control input-lg" })
                        <h4>CompanyName</h4>
                        @Html.TextBoxFor(CompanyName => CompanyName.CompanyName, new { @readonly = "readonly", @class = "form-control input-lg" })
                        <h4>ContactPerson</h4>
                        @Html.TextBoxFor(ContactPerson => ContactPerson.ContactPersonName, new { @readonly = "readonly", @class = "form-control input-lg" })
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-0 col-xs-0">
                    <div class="form-group">
                        <h4>DropUpdate</h4>
                        @Html.TextBoxFor(DropupDate => DropupDate.DropDate, new { @readonly = "readonly", @class = "form-control input-lg" })
                        <h4> DriverName</h4>

                        @Html.TextBoxFor(DriverName => DriverName.DriverName, new { @readonly = "readonly", @class = "form-control input-lg" })
                        <h4>DeliveryTime</h4>
                        <div class='input-group date' id='datetimepicker3'>
                            @Html.TextBoxFor(DropTime => DropTime.DeliveryTime, new { @class = "form-control", placeholder = "SelectTime" }) 
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-time"></span>
                            </span>
                        </div>
                       


                    </div>

                </div>
                <div class="col-lg-10">
                    <div class="col-lg-6">
                        <p style="font-size:24px">Is Goods Verified before Delivery </p>
                    </div>
                    <div class="col-lg-2">
                        @Html.LabelFor(VericationStatus1 => VericationStatus1.GoodsVeifactionStatus, "Yes")
                        @Html.RadioButtonFor(VerificationState => VerificationState.GoodsVeifactionStatus, "Yes")
                        @Html.LabelFor(VericationStatus2 => VericationStatus2.GoodsVeifactionStatus, "NO")
                        @Html.RadioButtonFor(VerificationState => VerificationState.GoodsVeifactionStatus, "No")`
                    </div>
                </div>
                <div class="col-lg-8">
                    <h3>
                        Your Message To Us
                    </h3>
                    @Html.TextAreaFor(DeliveryMsg => DeliveryMsg.DeliveryNotes, new { @class = "form-control input-lg", placeholder = "Your Important Message T0 Us" })

                </div>



            </div>
            <div class="row">
                <div class="col-lg-2">
                </div>
                <dic class="col-lg-6">
                    <input type="submit" value="SUBMIT" style="width:700px;height:40px;text-align:center;background-color:greenyellow;color:blue;font-size:20px" />
                </dic>
            </div>
        </div>
      
    </div>
          
          
    
    </div>      
    }
