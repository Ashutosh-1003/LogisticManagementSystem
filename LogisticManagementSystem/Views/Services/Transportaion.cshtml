@using (Html.BeginForm())
{
<form class="container">
    <div class="row" style="color:orange;margin-top:30px;margin-bottom:5px">
        <div class="col-sm-4"></div>
        <div class="col-sm-4"><h2>CUTOMBER ORDER FORM</h2></div>
    </div>
    <div class="row">
        <div class="col-lg-1 col-md-1 col-sm-0 col-xs-0">
        </div>
        <div class="col-lg-5 col-md-5 col-sm-0 col-xs-0" style="margin-top:10px;margin-bottom:50px">
            <div class="form-group">
                @Html.LabelFor(CompanName=>CompanName.CompanyName,"CompanyName")
                @Html.TextBoxFor(CompanyName => CompanyName.CompanyName, new { @class = "form-control input-lg", placeholder = "Enter Company name" })
            </div>
            <div class="form-group">
                @Html.LabelFor(ContactName=>ContactName.ContactPersonName,"ContactName")
                @Html.TextBoxFor(ContactName => ContactName.ContactPersonName, new { @class = "form-control input-lg", placeholder = "Enter Your Name" })
            </div>
            <div class="form-group">
                @Html.LabelFor(CompanyAdd=>CompanyAdd.CompanyStreetAdd,"Street Address")
                @Html.TextBoxFor(StreetAdd => StreetAdd.CompanyStreetAdd, new { @class = "form-control input-lg", placeholder = "Enter street address" })

                @Html.LabelFor(CompanyState=>CompanyState.CompanyState,"Company State")
                @Html.DropDownListFor(State => State.CompanyState, new SelectList(Model.ListofState), "-select-", new { @class = "form-control input-lg" })
                
                @Html.LabelFor(CompanyCity=>CompanyCity.CompanyCity,"CompanyCity")
                @Html.DropDownListFor(City => City.CompanyCity, new SelectList(Model.ListofCity), "-select-", new { @class = "form-control input-lg" })
                @Html.LabelFor(Companypin=>Companypin.CompanyPinId,"CompanyPinid")
                @Html.TextBoxFor(Pin => Pin.CompanyPinId, new { @class = "form-control input-lg", placeholder = "Enter pin" })
            </div>
            <div class="form-group">
                @Html.LabelFor(ContactNo=>ContactNo.ContactNumber,"Contact Number")
                @Html.TextBoxFor(ContactNo => ContactNo.ContactNumber, new { @class = "form-control input-lg", placeholder = "Enter contact number" })
                @Html.LabelFor(CompanyEmail=>CompanyEmail.CompanyEmail,"CompanyEmail")
                @Html.TextBoxFor(Email => Email.CompanyEmail, new { @class = "form-control input-lg", placeholder = "Enter Mail id" })
                @Html.LabelFor(CompanyType=>CompanyType.CompanyType,"Company Type")
                @Html.DropDownListFor(Company => Company.CompanyType, new SelectList(Model.ListofComtype), "-select-", new { @class = "form-control input-lg" })
                @Html.LabelFor(GoodsWeight=>GoodsWeight.GoodsWeight,"Goods Weight")
                @Html.TextBoxFor(GoodsWeight => GoodsWeight.GoodsWeight, new { @class = "form-control input-lg", placeholder = "Enter Goods Weight" })
            </div>
        </div>
        <div class="col-lg-5 col-md-5 col-sm-0 col-xs-0" style="margin-top:10px;margin-bottom:50px">


            <div class="form-group date mb-3" data-provide="datepicker">
                @Html.LabelFor(PickupDate=>PickupDate.PickUpDate,"PickUp Date")
                <div class="input-group">
                    @Html.TextBoxFor(PickupDate => PickupDate.PickUpDate, new { @class = "form-control datepicker", placeholder = "Pickupdate" })
                    <span class="input-group-addon">
                        <span class="glyphicon glyphicon-calendar"></span>
                    </span>
                </div>
            </div>
            <div class="form-group">
               @Html.LabelFor(PickupLocation=>PickupLocation.PickUpStreetAdd,"PIckUp Street")
                @Html.TextBoxFor(PickupStreet => PickupStreet.PickUpStreetAdd, new { @class = "form-control input-lg", placeholder = "Enter Pickup Street Address" })
                @Html.LabelFor(PickupState=>PickupState.PickUpState,"PickUp State")
                @Html.DropDownListFor(PickupState => PickupState.PickUpState, new SelectList(Model.ListofState), "-select-", new { @class = "form-control input-lg" })
                @Html.LabelFor(PickupCity=>PickupCity.PickUpCity,"PickUp City")
                @Html.DropDownListFor(PickupCity => PickupCity.PickUpCity, new SelectList(Model.ListofCity), "-select-", new { @class = "form-control input-lg" })
               @Html.LabelFor(PickupPin=>PickupPin.PickUpPin,"PickUp City Pin")
                @Html.TextBoxFor(PickupPin => PickupPin.PickUpPin, new { @class = "form-control input-lg", placeholder = "Enter Pickup pinid" })

                @Html.LabelFor(DropStreet=>DropStreet.DestinationStreetAdd,"DropUp Street Address")
                @Html.TextBoxFor(DropupLocation => DropupLocation.DestinationStreetAdd, new { @class = "form-control input-lg", placeholder = "Enter dropup Street Address" })
                @Html.LabelFor(DropUpsate=>DropUpsate.DestinationState,"Destination State")
                @Html.DropDownListFor(DropupState => DropupState.DestinationState, new SelectList(Model.ListofState), "-select-", new { @class = "form-control input-lg" })
               @Html.LabelFor(DropUpCity=>DropUpCity.DestinationCity,"Drop City")
                @Html.DropDownListFor(DropupCity => DropupCity.DestinationCity, new SelectList(Model.ListofCity), "-select-", new { @class = "form-control input-lg" })
                @Html.LabelFor(DropupPin=>DropupPin.DestinationPin,"Dropup PinId")
                @Html.TextBoxFor(DropupPin => DropupPin.DestinationPin, new { @class = "form-control input-lg", placeholder = "Enter dropup pinid" })


            </div>



        </div>

    </div>
    

    <input type="submit" value="Submit" style="background-color:cyan;width:700px;margin-left:200px;height:40px;font-size:26px;" id="btnsubmit" />
</form>
}


